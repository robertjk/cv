% Appearance: colors, links and section headings

\ProvidesPackage{style/appearance}

% Custom colors
\RequirePackage{xcolor}
\definecolor{linkblue}{HTML}{2858B0}

% Printing URL-s
\RequirePackage[colorlinks=true,urlcolor=linkblue]{hyperref}

% Don't style links with mono spaced fonts
\urlstyle{same}

% Section headings
\RedeclareSectionCommand
    [beforeskip=-0.7\baselineskip, afterskip=0.5\baselineskip, font=\large]
    {section}

% Add horizontal rule to section. Redefines how KOMA-Script lays out a heading:
% \sectionlinesformat gets the heading level (#1), its indent (#2), its number
% (#3) and its text (#4). Sections are set as a full-width box with the heading
% and, right below it, a rule: the kern pulls the rule up close to the text.
% Other levels keep the standard layout.
\makeatletter
\renewcommand{\sectionlinesformat}[4]{%
    \ifstr{#1}{section}{%
        \parbox[t]{\linewidth}{%
            \raggedsection\@hangfrom{\hskip #2#3}{#4}\par%
            \kern-.75\ht\strutbox\rule{\linewidth}{.8pt}%
        }%
    }{%
        \@hangfrom{\hskip #2#3}{#4}%
    }%
}
\makeatother

% Remove section numbers
\renewcommand*{\sectionformat}{}
