\ProvidesPackage{cv}


%%% Import packages

% Also using features from KOMA Script. This package is automatically imported
% by using scrartcl document class.

% Easy set up of page layout
\usepackage[verbose]{geometry}
% Custom colors
\usepackage{xcolor}
\definecolor{linkblue}{HTML}{2858B0}
% Printing URL-s
\usepackage[colorlinks=true,urlcolor=linkblue]{hyperref}
% Font loading by file, for XeLaTeX
\usepackage{fontspec}
% Extends styling options for lists
\usepackage{enumitem}
% For consistent styling of endings: 1st, 2nd, 3rd, 4th etc.
\usepackage[super]{nth}

%%% Meta information

\title{CV of Robert J.\ Kusznier}
\author{Robert J.\ Kusznier}
\date{}

%%% Style

% Main options normally specified along with the class
\KOMAoptions{
    fontsize=10pt,
    parskip=full,
}

% Geometry of the page
%
% The footer (page number) is centered vertically in the bottom margin: half of
% the margin plus half of the digit height (~2.3mm) gives the distance from the
% bottom of the text to the page number baseline.
\newlength{\cvbottommargin}
\setlength{\cvbottommargin}{28mm}
\newlength{\cvfootskip}
\setlength{\cvfootskip}{\dimexpr 0.5\cvbottommargin + 1.15mm\relax}
\geometry{
    letterpaper,
    hmargin=25mm,
    vmargin={25mm, \cvbottommargin},
    footskip=\cvfootskip,
}

% Use EB Garamond (SIL Open Font License) for all text. The font files live in the
% repo (fonts/EBGaramond), so the build does not depend on installed fonts. KOMA
% headings use the sans family, so the main and sans families are both set to it.
% Scale 1.097 makes its capital height match the sizes the layout was tuned with.
% The Medium weight is used for the subtitle (series "mb").
\setmainfont{EBGaramond-Regular}[
    Path=../fonts/EBGaramond/,
    Extension=.ttf,
    Scale=1.097,
    UprightFont=EBGaramond-Regular,
    ItalicFont=EBGaramond-Italic,
    BoldFont=EBGaramond-Bold,
    BoldItalicFont=EBGaramond-BoldItalic,
    FontFace={mb}{n}{EBGaramond-Medium},
]
\setsansfont{EBGaramond-Regular}[
    Path=../fonts/EBGaramond/,
    Extension=.ttf,
    Scale=1.097,
    UprightFont=EBGaramond-Regular,
    ItalicFont=EBGaramond-Italic,
    BoldFont=EBGaramond-Bold,
    BoldItalicFont=EBGaramond-BoldItalic,
    FontFace={mb}{n}{EBGaramond-Medium},
]

% Empty header and footer
\pagestyle{plain}

\RedeclareSectionCommand
    [beforeskip=-0.7\baselineskip, afterskip=0.5\baselineskip, font=\large]
    {section}

% Add horizontal rule to section
% \sectionfont{
%     \sectionrule{-8pt}{1pt}{0mm}{0mm}
% }
\makeatletter
\renewcommand{\sectionlinesformat}[4]{%
\ifstr{#1}{section}{%
    \parbox[t]{\linewidth}{%
      \raggedsection\@hangfrom{\hskip #2#3}{#4}\par%
      \kern-.75\ht\strutbox\rule{\linewidth}{.8pt}%
    }%
  }{%
    \@hangfrom{\hskip #2#3}{#4}}%
}
\makeatother

% Remove section numbers
\renewcommand*{\sectionformat}{}

% Don't style links with mono spaced fonts
\urlstyle{same}


%%% New commands and environments

% Title of the document
%
% Arguments:
% 1: Title
\newcommand{\documenttitle}[1]{
    {
        \raggedleft
        \bfseries
        \LARGE
        #1
        \par
    }
}

% List creating layout of each section
\newenvironment
    {sectionlist}
    {
        \begin{description}[
            align=right,
            labelwidth=42mm,
            labelsep=6mm,
            leftmargin=48mm,
            itemsep=2mm,
            parsep=0mm
        ]
    }
    {
        \end{description}
    }

% Single item (child) of section list
%
% Arguments:
% 1: Subsection title
% 2: Subsection contents
\newcommand{\sectionlistitem}[2]{
    \item[
        % Extra environment needed to properly parse [arg] to parbox
        {
            % 0mm height, so that it doesn't affect the layout by
            % increasing the line height
            \parbox[t][0mm]{42mm}{
                \raggedleft
                #1
            }
        }
    ] #2
}

% Special type of \sectionlistitem, which is a job description
%
% Arguments:
% 1: Job date
% 2: Job position
% 3: Company name
% 4: Company location
% 5: Description (rest of contents)
\newcommand{\sectionlistitemjob}[5]{
    \sectionlistitem
        {#1}
        {
            \textbf{#2} at \textbf{#3} (\emph{#4})
            #5
            \vspace{2mm}
        }
}

\usepackage{graphicx}
\newcommand{\bulletsmall}[1][0.7]{\mathbin{\vcenter{\hbox{\scalebox{#1}{$\bullet$}}}}}

% List listing details of one job
\newenvironment
    {joblisting}
    {
        \begin{itemize}[
            label=$\bulletsmall$,
            topsep=1.5mm,
            labelwidth=4mm,
            labelsep=2mm,
            leftmargin=6mm,
            itemsep=1.5mm,
            parsep=0mm
        ]
    }
    {
        \end{itemize}
    }
